@page "/Products/{id}"
@{
    ViewData["Title"] = "Product Detail";
}

<div class="d-flex justify-content-center text-center">
	<div id="product-container" style="margin-top: 10vh;">
		<p>Loading product...</p>
	</div>
</div>

<script src="~/js/cart.js"></script>

<script>
	async function loadProduct() {
		const productId = window.location.pathname.split("/").pop();

		try {
			const response = await fetch(`/api/products/${productId}`);
			const result = await response.json();
			const productContainer = document.getElementById("product-container");

			if (!response.ok) {
				productContainer.innerHTML = `<h1>Product not found.</h1>`;
				return;
			}

			const product = result.data;
			productContainer.innerHTML = `
				<div class="card h-100 shadow-sm" style="width: 30rem;">
					<img class="card-img-top" src="/images/${product.id}.png" onerror="this.src='https://dummyimage.com/480/dee2e6/6c757d.jpg'">
					<div class="card-body text-center d-flex flex-column">
						<h1>${product.name}</h1>
						<h4>$${product.price.toFixed(2)}</h4>
						<h4 class="flex-grow-1 d-flex align-items-center justify-content-center">
							<p class="mb-0 w-100">${product.description}</p>
						</h4>
						<div class="mt-4">
							<div class="d-flex align-items-center justify-content-center">
								<button class="btn btn-outline-secondary btn-lg" onclick="changeQuantity('${product.id}', -1)">−</button>
								<input type="number" id="quantity-${product.id}" class="form-control-lg text-center input-bg" min="1" value="1">
								<button class="btn btn-outline-secondary btn-lg" onclick="changeQuantity('${product.id}', 1)">+</button>
							</div>
							<button class="btn btn-success mt-3 btn-lg" onclick="addToCart('${product.id}')">Add to Cart</button>
						</div>
					</div>
				</div>
			`;

			loadCart();
		} catch (error) {
			document.getElementById("product-container").innerHTML = `<h1>Failed to load product.</h1>`;
		}
	}

	document.addEventListener("DOMContentLoaded", loadProduct);
</script>


