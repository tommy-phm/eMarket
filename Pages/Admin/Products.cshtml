@page
@model eMarket.Pages.Admin.ProductsModel
@{
    ViewData["Title"] = "Product Management";
}

<h1 class="text-center mb-4">Product Management</h1>

<div class="container">
    <div id="message-alert" class="alert d-none d-flex align-items-center fade show mb-4" role="alert">
        <svg class="bi flex-shrink-0 me-2" role="img" aria-label="Message">
            <use id="message-icon" xlink:href=""></use>
        </svg>
        <span id="message-text"></span>
    </div>

    <h3 class="mb-4">Add New Product</h3>
    <div class="card p-3 mb-4 border">
        <div class="row">
            <div class="col">
                <input type="text" id="newProductName" class="form-control" placeholder="Enter Product Name" required />
            </div>
            <div class="col">
                <input type="text" id="newProductDescription" class="form-control" placeholder="Enter Description" required />
            </div>
            <div class="col-sm-1">
                <input type="number" id="newProductPrice" class="form-control" placeholder="Enter Price" required />
            </div>
            <div class="col">
                <select id="newProductCategory" class="form-select">
                    <option value="">Loading categories...</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-success btn-sm h-100" onclick="addProduct()">Add Product</button>
            </div>
        </div>
    </div>

    <h3 class="mb-4">Existing Products</h3>
    <div id="product-container">
        <p>Loading products...</p>
    </div>
</div>

<script>
    async function loadProducts() {
        try {
            const categoryResponse = await fetch("/api/categories");
            if (!categoryResponse.ok) throw new Error("Failed to load categories.");
            const categories = await categoryResponse.json();

            const categoryMap = {};
            categories.data.forEach(category => {
                categoryMap[category.id] = category.name;
            });

            const categorySelect = document.getElementById("newProductCategory");
            categorySelect.innerHTML = categories.data.map(cat =>
                `<option value="${cat.id}">${cat.name}</option>`
            ).join("");

            const response = await fetch("/api/products");
            if (!response.ok) throw new Error("Failed to load products.");
            const result = await response.json();
            const productContainer = document.getElementById("product-container");

            if (!result.data || result.data.length === 0) {
                productContainer.innerHTML = "<p>No products found.</p>";
                return;
            }

            productContainer.innerHTML = `
                <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
                    ${result.data.map(product => `
                        <div class="col">
                            <div class="card h-100 shadow-sm" id="row-${product.id}">
                                <a href="/products/${product.id}">
                                    <img class="card-img-top" src="/images/${product.id}.png" onerror="this.src='https://dummyimage.com/250/dee2e6/6c757d.jpg'">
                                </a>
                                <div class="card-body text-center d-flex flex-column">
                                    <h5>
                                        <input class="form-control text-center" type="text" id="name-${product.id}" value="${product.name}" />
                                    </h5>
                                    <h6>
                                        <input class="form-control text-center" type="number" id="price-${product.id}" value="${product.price}" />
                                    </h6>
                                    <h6 class="flex-grow-1 d-flex align-items-center justify-content-center">
                                        <textarea class="form-control text-center" id="description-${product.id}">${product.description}</textarea>
                                    </h6>
                                    <select id="category-${product.id}" class="form-select">
                                        ${categories.data.map(cat => `
                                            <option value="${cat.id}" ${cat.id === product.category ? "selected" : ""}>${cat.name}</option>
                                        `).join("")}
                                    </select>
                                    <div class="mt-2">
                                        <button class="btn btn-primary btn-sm w-100" onclick="updateProduct('${product.id}')">Save</button>
                                        <button class="btn btn-danger btn-sm w-100 mt-2" onclick="deleteProduct('${product.id}')">Delete</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `).join("")}
                </div>
            `;
        } catch (error) {
            document.getElementById("product-container").innerHTML = `<p class="text-danger">Failed to load products: ${error.message}</p>`;
        }
    }

    document.addEventListener("DOMContentLoaded", loadProducts);

    async function addProduct() {
        const name = document.getElementById("newProductName").value.trim();
        const description = document.getElementById("newProductDescription").value.trim();
        const price = parseFloat(document.getElementById("newProductPrice").value);
        const category = document.getElementById("newProductCategory").value;

        if (!name || !description || isNaN(price) || !category) {
            showMessage("All fields are required.", "danger");
            return;
        }

        try {
            const response = await fetch("/api/products", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ name, description, price, category })
            });
            const result = await response.json();

            if (response.ok) {
                showMessage(result.message ?? "Product added successfully!", "success");
                loadProducts();
            } else {
                showMessage(result.error ?? "Failed to add product.", "danger");
            }
        } catch (error) {
            showMessage("Failed to add product: " + error.message, "danger");
        }
    }

    async function updateProduct(id) {
        const name = document.getElementById(`name-${id}`).value;
        const description = document.getElementById(`description-${id}`).value;
        const price = parseFloat(document.getElementById(`price-${id}`).value);
        const category = document.getElementById(`category-${id}`).value;

        try {
            const response = await fetch(`/api/products/${id}`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ name, description, price, category })
            });
            const result = await response.json();
            if (response.ok) {
                showMessage(result.message ?? "Product updated successfully!", "success");
            } else {
                showMessage(result.error ?? "Failed to update product.", "danger");
            }
        } catch (error) {
            showMessage("Failed to update product: " + error.message, "danger");
        }
    }

    async function deleteProduct(id) {
        if (!confirm("Are you sure you want to delete this product?")) return;

        try {
            const response = await fetch(`/api/products/${id}`, { method: "DELETE" });
            const result = await response.json();
            if (response.ok) {
                document.getElementById(`row-${id}`).remove();
                showMessage(result.message ?? "Product deleted successfully!", "success");
            } else {
                showMessage(result.error ?? "Failed to delete product.", "danger");
            }
        } catch (error) {
            showMessage("Failed to delete product: " + error.message, "danger");
        }
    }
</script>
