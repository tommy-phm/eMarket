@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="d-flex justify-content-center text-center">
    <div class="w-50" style="margin-top: 25vh;">
        <h1 class="display-3">eMarket</h1>
        <p>
            An e-commerce web application built with C#, .NET, and Bootstrap,
            It utilize MongoDB as the database for managing categories, products, users, and orders.
            A RESTful API facilitates interaction between the front end and back end
            It features user authentication, session tracking, and a shopping cart.
            The project includes a grocery dataset.
        </p>
        <a href="/products" class="btn btn-success">Browse Products</a>
    </div>
</div>